# Optional — every one of these has a working default in code. Copy to
# functions/.env (gitignored) only if you want to override something.
# Firebase's Python Functions Framework loads functions/.env automatically
# at deploy/runtime; no extra wiring needed.

# The one Google account this app is configured for. Must match
# VITE_ALLOWED_EMAIL (app/.env.local) and the email literal in
# firestore.rules — all three enforce the same restriction independently.
ALLOWED_EMAIL=filipaferreirasoares12@gmail.com

# Vertex AI region for both agents below.
VERTEX_LOCATION=us-central1

# Categorization agent (functions/categorize.py) — see its module comment
# for why this defaults to 2.5 instead of a newer Flash-Lite tier.
CATEGORIZATION_MODEL=gemini-2.5-flash-lite

# "Ask your finances" agent (functions/insights.py) — a step up from
# Flash-Lite since this is open-ended reasoning, not bounded classification.
INSIGHTS_MODEL=gemini-2.5-flash
